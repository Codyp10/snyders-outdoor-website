# Copy to .env.local for local dev, and set in Vercel project settings for production.
# Any variable prefixed with PUBLIC_ is exposed to the browser.

# Google Tag Manager container ID (GTM-XXXXXXX). Leave empty to disable tracking.
# All other tracking (GA4, CallRail, Microsoft Clarity) fires through GTM — do not add
# separate IDs here.
PUBLIC_GTM_ID=

# --- Sanity visual editing (Stage 2) -------------------------------------
# Leave ALL THREE unset/empty on the production site — it stays pure static.
# Set them ONLY on the dedicated preview deployment so the Studio's
# Presentation tool can show live, click-to-edit drafts.
#
# Turns the build into a server-rendered draft preview:
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false
# Viewer token (Sanity → API → Tokens, "Viewer" permission). SECRET — never commit.
SANITY_API_READ_TOKEN=
# The preview deployment's URL, e.g. https://sos-preview.vercel.app (used by the
# Studio to know where to load the live preview). Set on the PRODUCTION env.
PUBLIC_SANITY_PREVIEW_URL=
