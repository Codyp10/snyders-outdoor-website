---
import { Image } from 'astro:assets';
import business from '../data/business.json';
import nav from '../data/navigation.json';
import { phoneDisplay, phoneTel } from '../lib/nap';
import logo from '../assets/images/logo-white.png';

const year = new Date().getFullYear();
const treeServices = nav.primary.find((i) => i.label === 'Tree Services')?.children ?? [];
const addr = business.address;

const hasStreet = addr.street !== 'NAP_PENDING';
const hasPostal = addr.postalCode !== 'NAP_PENDING';
const gbpUrl = business.gbpUrl !== 'NAP_PENDING' ? business.gbpUrl : '';
const facebookUrl = business.sameAs.find((u) => u.includes('facebook.com')) ?? '';
---

<footer class="bg-brand-dark text-white pt-16 pb-8 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <Image
          src={logo}
          alt={business.name}
          widths={[240, 320]}
          sizes="200px"
          loading="lazy"
          class="h-16 w-auto mb-4"
        />
        <p class="text-white/70 text-sm leading-relaxed">
          Professional tree service and outdoor solutions serving Williamsport, Hagerstown, Greencastle, Waynesboro, Frederick, and Martinsburg.
        </p>
      </div>

      <div>
        <h2 class="font-heading font-bold text-sm uppercase tracking-wider text-white/90 mb-3">Quick Links</h2>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-white/70 hover:text-white">Home</a></li>
          <li><a href="/about" class="text-white/70 hover:text-white">About</a></li>
          <li><a href="/service-areas" class="text-white/70 hover:text-white">Service Areas</a></li>
          <li><a href="/blog" class="text-white/70 hover:text-white">Tips & Resources</a></li>
          <li><a href="/contact" class="text-white/70 hover:text-white">Contact</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-heading font-bold text-sm uppercase tracking-wider text-white/90 mb-3">Tree Services</h2>
        <ul class="space-y-2 text-sm">
          {treeServices.map((s) => (
            <li><a href={s.href} class="text-white/70 hover:text-white">{s.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="font-heading font-bold text-sm uppercase tracking-wider text-white/90 mb-3">Contact</h2>
        <address class="not-italic text-sm text-white/70 space-y-2">
          <div>
            <div class="font-semibold text-white">{business.name}</div>
            {hasStreet && <div>{addr.street}</div>}
            <div>{addr.city}, {addr.region}{hasPostal ? ` ${addr.postalCode}` : ''}</div>
          </div>
          <div>
            <a href={`tel:${phoneTel}`} class="text-white font-semibold hover:text-brand-light">
              {phoneDisplay}
            </a>
          </div>
          <div>
            <div>Mon–Fri 8AM–5PM</div>
            <div>24/7 emergency response</div>
          </div>
        </address>
        {(gbpUrl || facebookUrl) && (
          <div class="flex items-center gap-3 mt-4">
            {gbpUrl && (
              <a
                href={gbpUrl}
                target="_blank"
                rel="noopener"
                aria-label="Snyder's Outdoor Solutions on Google"
                class="text-white/70 hover:text-white"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/>
                </svg>
              </a>
            )}
            {facebookUrl && (
              <a
                href={facebookUrl}
                target="_blank"
                rel="noopener"
                aria-label="Snyder's Outdoor Solutions on Facebook"
                class="text-white/70 hover:text-white"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22 12.07C22 6.5 17.52 2 12 2S2 6.5 2 12.07C2 17.1 5.66 21.24 10.44 22v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.9h-2.34V22C18.34 21.24 22 17.1 22 12.07z"/>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 mt-12 flex flex-col sm:flex-row justify-between gap-4 text-xs text-white/50">
      <div>© {year} {business.name}. All rights reserved.</div>
      <div class="flex gap-4">
        <a href="/privacy" class="hover:text-white">Privacy Policy</a>
        <a href="/terms" class="hover:text-white">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
