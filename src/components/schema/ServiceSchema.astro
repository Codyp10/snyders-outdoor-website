---
import business from '../../data/business.json';

interface Props {
  serviceName: string;
  serviceType?: string;
  description?: string;
  /** URL of the page this schema is on */
  url: string;
  /** City/region this service is offered in (one city or the full service area) */
  areaServed: { city: string; region: string } | { city: string; region: string }[];
  /** @id of the LocalBusiness this service is provided by */
  providerId?: string;
  /** Optional node @id (used on service-area pages) */
  id?: string;
}

const {
  serviceName,
  serviceType,
  description,
  url,
  areaServed,
  providerId = `${business.url}/#business`,
  id,
} = Astro.props;

const cities = Array.isArray(areaServed) ? areaServed : [areaServed];
const areaServedNodes = cities.map((a) => ({
  '@type': 'City',
  name: `${a.city}, ${a.region}`,
}));

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  serviceType: serviceType ?? serviceName,
  url,
  provider: { '@id': providerId },
  areaServed: areaServedNodes.length === 1 ? areaServedNodes[0] : areaServedNodes,
};

if (id) jsonLd['@id'] = id;
if (description) jsonLd.description = description;
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
