---
import type { ReviewDoc } from '../sanity/lib/queries';

interface Props {
  reviews: ReviewDoc[];
  heading?: string;
  subhead?: string;
}

const { reviews = [], heading = 'What Homeowners Say', subhead } = Astro.props;

const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

{
  reviews.length > 0 && (
    <section class="bg-stone-50 py-16 md:py-24 border-y border-gray-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center mb-10 md:mb-14">
          <h2 class="font-heading font-bold text-gray-900 text-3xl md:text-4xl">{heading}</h2>
          {subhead && <p class="mt-4 text-gray-600 text-base md:text-lg leading-relaxed">{subhead}</p>}
        </div>
        <div class="grid gap-5 md:gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r) => (
            <figure class="flex flex-col bg-white rounded-2xl ring-1 ring-gray-200 shadow-sm p-6 md:p-7">
              <div class="flex gap-0.5 mb-3" aria-label={`${r.rating} out of 5 stars`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg
                    class:list={['w-5 h-5', i < r.rating ? 'text-orange-400' : 'text-gray-200']}
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
              </div>
              <blockquote class="text-gray-800 leading-relaxed flex-1">{r.quote}</blockquote>
              <figcaption class="mt-5 flex items-center gap-3 text-sm">
                <div class="w-10 h-10 rounded-full bg-brand-dark text-white font-bold flex items-center justify-center" aria-hidden="true">
                  {initials(r.name)}
                </div>
                <div>
                  <div class="font-bold text-gray-900">{r.name}</div>
                  <div class="text-gray-500 text-xs">
                    {r.town}
                    {r.service && r.service !== 'Other' ? ` · ${r.service}` : ''}
                  </div>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
