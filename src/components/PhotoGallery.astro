---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  heading?: string;
  subhead?: string;
  items: GalleryItem[];
  /** Section background — alternate against neighboring sections. */
  tone?: 'white' | 'stone';
}

const { heading = 'Recent Work', subhead, items, tone = 'stone' } = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['py-16 md:py-24', tone === 'stone' ? 'bg-stone-50 border-y border-gray-100' : 'bg-white']}>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-10 md:mb-14">
          <h2 class="font-heading font-bold text-gray-900 text-3xl md:text-4xl">{heading}</h2>
          {subhead && <p class="mt-4 text-gray-600 text-base md:text-lg leading-relaxed">{subhead}</p>}
        </div>
        <div class:list={['grid gap-5 md:gap-6', items.length === 1 ? 'max-w-3xl' : items.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3']}>
          {items.map((item) => (
            <figure class="rounded-2xl overflow-hidden bg-white ring-1 ring-gray-200 shadow-sm">
              <div class="relative aspect-[4/3] overflow-hidden bg-brand-dark">
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[480, 768, 1080]}
                  sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover"
                />
              </div>
              {item.caption && (
                <figcaption class="px-4 py-3 text-sm text-gray-600 leading-snug">{item.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
